rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;
    }

    match /users_auth/{emailDoc} {
      allow read, write: if true;
    }

    match /restaurants/{restaurantId} {
      // Restaurant info and settings readable and writable
      allow read, write: if true;

      match /menuItems/{itemId} {
        // Menu items readable and writable
        allow read, write: if true;
      }
      
      match /sessions/{sessionId} {
        // Sessions readable and writable by dashboard staff and customer QR apps
        allow read, create, update: if true;
        allow delete: if true;
      }

      match /orders/{orderId} {
        // Orders readable and writable by dashboard staff and customer QR apps
        allow read, create, update, delete: if true;
      }
    }
  }
}
