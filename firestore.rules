rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Staff are authenticated with non-anonymous providers (e.g. password, google)
    function isStaff() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    match /users/{userId} {
      allow read, write: if request.auth.uid == userId;
    }

    match /users_auth/{emailDoc} {
      allow read, write: if true;
    }

    match /restaurants/{restaurantId} {
      // Restaurant info is public (name, logo, etc.)
      allow read: if true;
      // Only staff can update restaurant details
      allow write: if isStaff();

      match /menuItems/{itemId} {
        // Menu is publicly readable (customers browse it)
        allow read: if true;
        // Only staff can add/edit/delete menu items
        allow write: if isStaff();
      }
      
      match /sessions/{sessionId} {
        // Sessions readable and writable by dashboard staff and customer QR apps
        allow read, create, update: if true;
        allow delete: if true;
      }

      match /orders/{orderId} {
        // Orders readable and writable by dashboard staff and customer QR apps
        allow read, create, update, delete: if true;
      }
    }
  }
}
